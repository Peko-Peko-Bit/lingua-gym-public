OPENROUTER_API_KEY=        # OpenRouter APIキー（翻訳・添削共通）
GOOGLE_CLOUD_VISION_KEY=   # Google Cloud Vision APIキー（OCR用）

# Supabase — https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # 認証（proxy / auth server client）で使用
SUPABASE_SERVICE_ROLE_KEY=       # サーバーサイド専用。絶対に公開しないこと

# Google Auth — クッキーをサブドメイン間で共有するための親ドメイン
# ローカル開発では未設定のままにすること（localhost は共有不要）
# 本番例: NEXT_PUBLIC_COOKIE_DOMAIN=.pekobit.com
NEXT_PUBLIC_COOKIE_DOMAIN=
